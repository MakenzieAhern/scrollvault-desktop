<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="root" styleClass="login-root, dark" fx:controller="com.vsas.controllers.LoginController">
    <top>
    <StackPane>
        <VBox spacing="6" styleClass="glass-card, square">
            <padding>
                <Insets top="10" right="10" left="10"/>
            </padding>
            <HBox alignment="CENTER" spacing="8">
                <Label text="SCROLLVAULT DESKTOP" styleClass="card-title"
                       style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 28px;" />
            </HBox>
            <HBox alignment="CENTER" spacing="4">
                <Label text="Your local library for documents and images" styleClass="card-title"
                       style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 24px;" />
            </HBox>
        </VBox>
    </StackPane>
    </top>
    <center>
        <StackPane>
            <Pane styleClass="login-bg" />
            <Pane fx:id="blobLayer" />
            <Pane fx:id="particlesLayer" />
            <VBox alignment="CENTER" spacing="24">
                <VBox spacing="16" styleClass="glass-card, square" maxWidth="600">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                    <Label wrapText="true" maxWidth="560" styleClass="form-label" alignment="CENTER" textAlignment="CENTER" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 20px;">
                        Sign in with your username and password.
                        New here? Click Register or Continue As Guest.
                        <VBox.margin><Insets bottom="16"/></VBox.margin>
                    </Label>
					<GridPane hgap="10" vgap="12" alignment="CENTER">
						<columnConstraints>
							<ColumnConstraints halignment="RIGHT"/>
							<ColumnConstraints hgrow="ALWAYS"/>
						</columnConstraints>
                        <children>
                            <Label text="Username" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="usernameField" promptText="Enter your username" GridPane.rowIndex="0" GridPane.columnIndex="1" prefHeight="48" style="-fx-font-size: 20px;"/>
                            <Label text="Password" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <PasswordField fx:id="passwordField" promptText="Enter your password" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="48" style="-fx-font-size: 20px;"/>
                        </children>
                    </GridPane>
                    <HBox spacing="12" alignment="CENTER">
                        <Button fx:id="loginButton" text="Log In" onAction="#onLogin" styleClass="cta-btn" prefHeight="44" />
                    </HBox>
                    <HBox alignment="CENTER">
                        <Label fx:id="messageLabel" styleClass="banner-error" visible="false" managed="false" />
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <VBox.margin><Insets top="24"/></VBox.margin>
                        <Button fx:id="registerBtn" text="Register" onAction="#onRegister" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <Button fx:id="guestBtn" text="Continue As Guest" onAction="#onContinueAsGuest" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <Button text="Go Back" onAction="#onGoBack" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                    </HBox>

                </VBox>
            </VBox>
        </StackPane>
    </center>
    <bottom>
        <BorderPane>
            <left>
                <HBox alignment="CENTER_LEFT" spacing="24">
                    <padding><Insets top="10" bottom="10" left="10"/></padding>
                    <Label text="v1.0.0" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 18px;" />
                    <Label text="Built with JavaFX &amp; Gradle" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 18px;" />
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT">
                    <padding><Insets top="10" bottom="10" right="10"/></padding>
                    <Label fx:id="dateTimeLabel" style="-fx-text-fill: black; -fx-font-weight: 700; -fx-font-size: 16px;" />
                </HBox>
            </right>
        </BorderPane>
    </bottom>
</BorderPane>
