<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="root" fx:controller="com.vsas.controllers.AdminPanelController" styleClass="login-root, dark">
    <top>
        <BorderPane>
            <left>
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <padding><Insets top="10" left="10"/></padding>
                        <Label text="ScrollVault Desktop" styleClass="hero-title" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <padding><Insets left="10" bottom="10"/></padding>
                        <Label text="Admin Panel - Manage Users" styleClass="card-title" />
                    </HBox>
                </VBox>
            </left>
            <right>
                <HBox />
            </right>
        </BorderPane>
    </top>
    <center>
        <StackPane>
            <Pane fx:id="blobLayer" />
            <Pane fx:id="particlesLayer" />
            <BorderPane StackPane.alignment="CENTER">
                <padding><Insets top="40" bottom="40" left="40" right="40"/></padding>
                <center>
                    <VBox spacing="20" alignment="TOP_CENTER">
                        <!-- User Management Card -->
                        <VBox spacing="8" styleClass="glass-card, square" maxWidth="900" prefWidth="900">
                            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                            <Label text="User Management" styleClass="card-title" />

                            <!-- Search Bar -->
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <TextField fx:id="txtSearch" promptText="Search by ID, Username, Full Name, Phone, or Role..." HBox.hgrow="ALWAYS" />
                                <Button text="Clear" onAction="#onClearSearch" prefWidth="80" />
                            </HBox>

                            <!-- User Table -->
                            <TableView fx:id="userTable" prefHeight="400">
                                <columns>
                                    <TableColumn fx:id="colIdKey" text="ID Key" prefWidth="120" />
                                    <TableColumn fx:id="colUsername" text="Username" prefWidth="120" />
                                    <TableColumn fx:id="colFullName" text="Full Name" prefWidth="150" />
                                    <TableColumn fx:id="colPhone" text="Phone Number" prefWidth="120" />
                                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180" />
                                    <TableColumn fx:id="colRole" text="Role" prefWidth="100" />
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Action Buttons -->
                        <VBox spacing="12" alignment="CENTER">
                            <!-- Row 1: Add User | Set as Admin -->
                            <HBox spacing="12" alignment="CENTER">
                                <Button text="Add User" onAction="#onAddUser" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                                <Button fx:id="btnSetAdmin" text="Set as Admin" onAction="#onSetAdmin" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                            </HBox>

                            <!-- Row 2: Remove User | Set as General -->
                            <HBox spacing="12" alignment="CENTER">
                                <Button text="Remove User" onAction="#onRemoveUser" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                                <Button fx:id="btnSetGeneral" text="Set as General" onAction="#onSetGeneral" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                            </HBox>

                            <!-- Row 3: Go Back | Refresh -->
                            <HBox spacing="12" alignment="CENTER">
                                <Button text="Go Back" onAction="#onGoBack" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                                <Button text="Refresh" onAction="#onRefresh" styleClass="cta-btn" prefHeight="44" prefWidth="200" />
                            </HBox>
                        </VBox>

                        <!-- Message Label -->
                        <Label fx:id="messageLabel" styleClass="banner-error" visible="false" managed="false" wrapText="true" />
                    </VBox>
                </center>
            </BorderPane>
        </StackPane>
    </center>
    <bottom>
        <BorderPane>
            <left>
                <HBox alignment="CENTER_LEFT" spacing="24">
                    <padding><Insets top="10" bottom="10" left="10"/></padding>
                    <Label text="v1.0.0" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 18px;" />
                    <Label text="Built with JavaFX &amp; Gradle" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 18px;" />
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT">
                    <padding><Insets top="10" bottom="10" right="10"/></padding>
                    <Label fx:id="dateTimeLabel" style="-fx-text-fill: black; -fx-font-weight: 700; -fx-font-size: 16px;" />
                </HBox>
            </right>
        </BorderPane>
    </bottom>
</BorderPane>
