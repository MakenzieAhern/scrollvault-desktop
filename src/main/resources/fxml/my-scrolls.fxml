<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.vsas.controllers.ScrollsController" styleClass="login-root, dark">
  <top>
    <BorderPane>
      <left>
        <VBox spacing="6">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="10" left="10"/></padding>
            <Label text="ScrollVault Desktop" styleClass="hero-title" />
          </HBox>
          <HBox alignment="CENTER_LEFT">
            <padding><Insets left="10" bottom="10"/></padding>
            <Label text="My Scrolls" styleClass="card-title" />
          </HBox>
        </VBox>
      </left>
      <right>
        <HBox />
      </right>
    </BorderPane>
  </top>
  <center>
    <StackPane>
      <Pane styleClass="login-bg" />
      <Pane fx:id="blobLayer" />
      <Pane fx:id="particlesLayer" />
      <VBox alignment="CENTER" spacing="16" StackPane.alignment="CENTER">
        <padding><Insets top="20" bottom="40" left="20" right="20"/></padding>
        <BorderPane maxWidth="1100" prefWidth="980">
          <center>
            <SplitPane dividerPositions="0.50">
              <items>
                <VBox spacing="8" styleClass="glass-card, square">
                  <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
                  <Label text="Your Scrolls" styleClass="card-title" />
                  <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="txtKeyword" promptText="Search ID or Title" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="cmbType" promptText="Type" prefWidth="90" />
                    <ComboBox fx:id="cmbSort" promptText="Sort" prefWidth="90" />
                    <CheckBox fx:id="chkAsc" text="Asc" minWidth="55" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="8">
                    <DatePicker fx:id="dpFrom" promptText="From" />
                    <DatePicker fx:id="dpTo" promptText="To" />
                    <Button fx:id="btnClear" text="Clear" minWidth="55" onAction="#onClearFilters" />
                  </HBox>
                  <Separator />
                  <TableView fx:id="table" prefHeight="440">
                    <columns>
                      <TableColumn fx:id="colId" text="ID" prefWidth="65"/>
                      <TableColumn fx:id="colTitle" text="Title" prefWidth="205"/>
                      <TableColumn fx:id="colType" text="Type" prefWidth="85"/>
                      <TableColumn fx:id="colDate" text="Upload Date" prefWidth="120"/>
                    </columns>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button fx:id="btnEdit" text="Edit Scroll" onAction="#onEdit" styleClass="cta-btn" prefHeight="40" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnDelete" text="Remove Scroll" onAction="#onDelete" styleClass="cta-btn" prefHeight="40" />
                  </HBox>
                </VBox>
                <VBox spacing="8" styleClass="glass-card, square">
                  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                  <Label fx:id="previewTitle" styleClass="card-title" />
                  <Label wrapText="true" fx:id="previewInfo" styleClass="card-title" />
                  <StackPane prefHeight="420">
                    <TextArea fx:id="textPreview" wrapText="true" prefRowCount="18" />
                    <ImageView fx:id="imagePreview" preserveRatio="true" fitWidth="600" visible="false" managed="false" />
                  </StackPane>
                </VBox>
              </items>
            </SplitPane>
          </center>
        </BorderPane>
        <HBox alignment="CENTER" spacing="12">
          <Label fx:id="messageLabel" styleClass="banner-error" visible="false" managed="false" />
        </HBox>
        <HBox alignment="CENTER" spacing="12">
          <Button text="Back to All Scrolls" onAction="#onBackToAllScrolls" styleClass="cta-btn" prefHeight="44" prefWidth="220" />
        </HBox>
      </VBox>
    </StackPane>
  </center>
  <bottom>
    <BorderPane>
      <left>
        <HBox alignment="CENTER_LEFT" spacing="24">
          <padding><Insets top="10" bottom="10" left="10"/></padding>
          <Label text="v1.0.0" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 18px;" />
          <Label text="Built with JavaFX &amp; Gradle" style="-fx-text-fill: black; -fx-font-weight: 800; -fx-font-size: 18px;" />
        </HBox>
      </left>
      <right>
        <HBox alignment="CENTER_RIGHT">
          <padding><Insets top="10" bottom="10" right="10"/></padding>
          <Label fx:id="dateTimeLabel" style="-fx-text-fill: black; -fx-font-weight: 700; -fx-font-size: 16px;" />
        </HBox>
      </right>
    </BorderPane>
  </bottom>
</BorderPane>
